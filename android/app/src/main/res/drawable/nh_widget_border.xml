<?xml version="1.0" encoding="utf-8"?>
<!-- Transparent-fill, stroke-only overlay for the NanoHive widget — drawn via
     android:foreground so it sits on top of the (dynamically alpha-tinted,
     see NanoHiveMediaPlayerWidget.kt) translucent background without the
     stroke itself being affected by that runtime tint. Matches the in-app
     mini player's 1px rgba(255,255,255,0.14) border (nh-theme.css). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
  <solid android:color="@android:color/transparent" />
  <stroke android:width="1dp" android:color="#24ffffff" />
  <corners android:radius="20dp" />
</shape>
