<!-- Deliberately shaped after the in-app mini player (components/app/AudioPlayer.vue's
     #playerContent when not fullscreen) rather than the original widget's boxy
     grid: translucent glass bar, small cover + title/author on top, a full
     transport row (bookmark, rewind, play/pause, forward, sleep timer) below
     it, and a thin progress track along the very bottom. Corner rounding on
     Android 12+ is applied automatically by the system to every widget (see
     values-v31/themes.xml's appWidgetRadius) — nothing extra needed here for
     that part; nh_widget_border.xml supplies the mini player's subtle edge
     stroke on top of it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:id="@+id/widgetBackground"
  android:layout_width="fill_parent"
  android:layout_height="fill_parent"
  android:orientation="vertical"
  android:background="#1a1611"
  android:foreground="@drawable/nh_widget_border">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <ImageView
      android:id="@+id/widgetAlbumArt"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1"
      android:layout_margin="8dp"
      android:scaleType="centerCrop"
      android:src="@drawable/icon" />

    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="4"
      android:orientation="vertical"
      android:gravity="center_vertical">

      <TextView
        android:id="@+id/widgetMediaTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="bottom"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#f4eee2"
        android:textSize="13sp"
        android:text="Title"/>

      <TextView
        android:id="@+id/widgetArtistText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="top"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#e0c27a"
        android:textSize="11sp"
        android:text="Artist"/>
    </LinearLayout>
  </LinearLayout>

  <!-- Full transport row, mirroring the mini player's actual button set
       (bookmark, jump back, play/pause, jump forward, sleep timer) instead of
       just the three the original widget has. -->
  <LinearLayout
    android:id="@+id/widgetButtonContainer"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <ImageView
      android:id="@+id/widgetBookmarkButton"
      android:layout_width="0dp"
      android:layout_height="30dp"
      android:layout_weight="1"
      android:layout_margin="4dp"
      android:padding="4dp"
      android:scaleType="fitCenter"
      android:src="@drawable/nh_widget_icon_bookmark" />

    <ImageView
      android:id="@+id/widgetRewindButton"
      android:layout_width="0dp"
      android:layout_height="34dp"
      android:layout_weight="1"
      android:layout_margin="4dp"
      android:scaleType="fitCenter"
      android:src="@drawable/exo_icon_rewind" />

    <ImageView
      android:id="@+id/widgetPlayPauseButton"
      android:layout_width="0dp"
      android:layout_height="34dp"
      android:layout_weight="1"
      android:layout_margin="4dp"
      android:scaleType="fitCenter"
      android:src="@drawable/ic_media_play_dark" />

    <ImageView
      android:id="@+id/widgetFastForwardButton"
      android:layout_width="0dp"
      android:layout_height="34dp"
      android:layout_weight="1"
      android:layout_margin="4dp"
      android:scaleType="fitCenter"
      android:src="@drawable/exo_icon_fastforward" />

    <ImageView
      android:id="@+id/widgetSleepTimerButton"
      android:layout_width="0dp"
      android:layout_height="30dp"
      android:layout_weight="1"
      android:layout_margin="4dp"
      android:padding="4dp"
      android:scaleType="fitCenter"
      android:src="@drawable/nh_widget_icon_sleep" />

  </LinearLayout>

  <!-- Mirrors the mini player's thin progress track along the very bottom of
       the card (playerTrack in AudioPlayer.vue). Amber-tinted via
       progressTint/progressBackgroundTint in Kotlin. -->
  <ProgressBar
    android:id="@+id/widgetProgressBar"
    style="?android:attr/progressBarStyleHorizontal"
    android:layout_width="match_parent"
    android:layout_height="4dp"
    android:max="1000"
    android:progress="0" />

</LinearLayout>
