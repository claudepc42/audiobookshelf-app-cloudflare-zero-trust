<!-- Proportional layout: every size/position below is a RATIO of available
     space, not a fixed dp value — so the same relative design holds
     whether the widget renders at the nominal 97dp or the much taller
     size we've measured it actually get on-device (a real launcher can
     give this widget a different footprint than the declared minHeight,
     confirmed by measurement — see NanoHiveMediaPlayerWidget.kt history).
     A fixed-dp version only ever looked right at one specific size; this
     version scales.

     How: cover width, and the three content rows' heights, are all
     weighted 0dp+layout_weight fractions of their parent — the WEIGHT
     NUMBERS are the real measured dp values from the design (cover
     91dp / gap 4dp / column 169dp; row heights 32dp / 44dp / 33dp), reused
     as ratios rather than literal sizes. Icon SIZES are never given a
     fixed dp at all: each icon is android:layout_height="match_parent"
     (fills whatever height its row's weight resolves to) with
     android:layout_width="wrap_content" and android:adjustViewBounds="true",
     so Android derives the icon's width from its own square aspect ratio
     scaled to that resolved height — the icon's visual size is a pure
     function of available space, never a hardcoded number. Gaps between
     the three transport icons are 0dp+weight spacer Views (space-around
     style) so leftover horizontal room, not a fixed margin, becomes the
     gap. The two exceptions are: (1) TEXT size (sp), since RemoteViews
     doesn't reliably support auto-sizing TextViews — these stay fixed,
     tuned from direct on-device feedback; (2) the root's own
     padding/corner-radius clearance, which is about staying clear of the
     frame's fixed-dp corner radius, not a content proportion. Corner
     rounding on Android 12+ is applied automatically by the system to
     every widget (see values-v31/themes.xml's appWidgetRadius);
     nh_widget_border.xml supplies the mini player's subtle edge stroke on
     top of it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:id="@+id/widgetBackground"
  android:layout_width="fill_parent"
  android:layout_height="fill_parent"
  android:orientation="horizontal"
  android:paddingEnd="9dp"
  android:background="#1a1611"
  android:foreground="@drawable/nh_widget_border">

  <!-- Cover: weight 91 of a 91:4:169 row split (the real measured cover
       width : gap : column dp values, reused as ratios). No margin at
       all — touches the top, left, and bottom edges directly. The
       system already clips every widget's corners to the frame's
       corner radius on Android 12+ (values-v31/themes.xml's
       appWidgetRadius), so the cover's own corners get cut by that
       same clipping rather than an explicit inset — deliberate, not
       an oversight. -->
  <ImageView
    android:id="@+id/widgetAlbumArt"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="91"
    android:scaleType="centerCrop"
    android:src="@drawable/icon" />

  <!-- Gap: weight 4, matching the cover's own measured margin — a real
       spacer rather than a margin, so it scales with the row too. Uses an
       empty ImageView, not a plain View: RemoteViews only inflates a fixed
       allowlist of view classes (layout containers + specific widgets like
       ImageView/TextView/ProgressBar), and bare android.view.View is NOT
       on it — using one here would crash the widget at inflation instead
       of just looking wrong. -->
  <ImageView
    android:layout_width="0dp"
    android:layout_height="0dp"
    android:layout_weight="4" />

  <!-- Content column: weight 169 (the remaining measured width). Its own
       top/bottom margin (2dp each) now lives HERE instead of on the root's
       padding, since the cover no longer wants any top/bottom inset at
       all — this keeps the column's own text/icons clear of the frame's
       top-right/bottom-right corner radius without re-adding a margin to
       the cover too. Its three rows split the FULL available height by
       weight (32:44:33, the real measured row-height dp values) rather
       than each being wrap_content at a fixed size — this is what lets
       icons resize instead of clip/overflow when the widget renders
       taller or shorter than 97dp. -->
  <LinearLayout
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="169"
    android:layout_marginTop="2dp"
    android:layout_marginBottom="2dp"
    android:orientation="vertical">

    <!-- Row 1 (weight 32): title/author on the left, bookmark+sleep
         pinned to the right. Top-aligned (not centered) within its own
         weighted box: this row's content is shorter than its box, and
         top-aligning it pushes that leftover space DOWN, between the
         author text and the transport row — evening out the previously
         lopsided gap (title/author was nearly touching the transport row,
         while row 3 below had a big gap above the time text; row 3 is
         fixed the same way). -->
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="32"
      android:orientation="horizontal"
      android:gravity="top">

      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
          android:id="@+id/widgetMediaTitle"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:ellipsize="end"
          android:maxLines="1"
          android:textColor="#f4eee2"
          android:textSize="14sp"
          android:text="Title"/>

        <TextView
          android:id="@+id/widgetArtistText"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:ellipsize="end"
          android:maxLines="1"
          android:textColor="#e0c27a"
          android:textSize="12sp"
          android:text="Artist"/>
      </LinearLayout>

      <LinearLayout
        android:id="@+id/widgetSecondaryButtonContainer"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
          android:id="@+id/widgetBookmarkButton"
          android:layout_width="wrap_content"
          android:layout_height="match_parent"
          android:adjustViewBounds="true"
          android:layout_marginEnd="7dp"
          android:scaleType="fitCenter"
          android:src="@drawable/nh_widget_icon_bookmark" />

        <ImageView
          android:id="@+id/widgetSleepTimerButton"
          android:layout_width="wrap_content"
          android:layout_height="match_parent"
          android:adjustViewBounds="true"
          android:scaleType="fitCenter"
          android:src="@drawable/nh_widget_icon_sleep" />
      </LinearLayout>
    </LinearLayout>

    <!-- Row 2 (weight 44): transport row. Icons are non-weighted
         (natural width, derived from their own resolved height via
         adjustViewBounds); the four empty-ImageView spacers ARE weighted
         (1 each), so leftover horizontal room splits evenly around/between
         them — space-around, not a fixed dp gap. -->
    <LinearLayout
      android:id="@+id/widgetButtonContainer"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="44"
      android:orientation="horizontal"
      android:gravity="center_vertical">

      <ImageView android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />

      <ImageView
        android:id="@+id/widgetRewindButton"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter"
        android:src="@drawable/exo_icon_rewind" />

      <ImageView android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />

      <ImageView
        android:id="@+id/widgetPlayPauseButton"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_media_play_dark" />

      <ImageView android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />

      <ImageView
        android:id="@+id/widgetFastForwardButton"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter"
        android:src="@drawable/exo_icon_fastforward" />

      <ImageView android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />
    </LinearLayout>

    <!-- Row 3 (weight 33): time labels + progress bar, filling the
         column's full width (same left edge as title, same right edge
         as the bookmark/sleep group above). Top-aligned, not centered —
         this row has the most leftover space of the three (its content is
         shorter than a 33-weight box), and top-aligning it puts that
         content immediately after the transport row instead of leaving a
         big gap above it; the leftover space moves to the very bottom of
         the widget instead, which is far less noticeable than a gap
         between transport and time. -->
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="33"
      android:orientation="vertical"
      android:gravity="top">

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
          android:id="@+id/widgetCurrentTime"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:gravity="start"
          android:textColor="#9a9085"
          android:textSize="12sp"
          android:fontFamily="monospace"
          android:text="0:00"/>

        <TextView
          android:id="@+id/widgetTimeRemaining"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:gravity="end"
          android:textColor="#9a9085"
          android:textSize="12sp"
          android:fontFamily="monospace"
          android:text="-0:00"/>
      </LinearLayout>

      <ProgressBar
        android:id="@+id/widgetProgressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="7dp"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="3dp"
        android:progressDrawable="@drawable/nh_widget_progress"
        android:max="1000"
        android:progress="0" />
    </LinearLayout>
  </LinearLayout>

</LinearLayout>
